---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
// e.g. with base "/blog": "/blog/posts/slug" → "/posts/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const navItems = [
  { path: "", label: t.nav.home },
  { path: "posts", label: t.nav.posts },
  { path: "cs", label: t.nav.cs },
  { path: "data-structure", label: t.nav.dataStructure },
  { path: "algorithm", label: t.nav.algorithm },
  { path: "language", label: t.nav.language },
  { path: "mobile", label: t.nav.mobile },
  { path: "server", label: t.nav.server },
  { path: "projects", label: t.nav.projects },
  { path: "about", label: t.nav.about },
  ...(features.showArchives
    ? [{ path: "archives", label: t.nav.archives }]
    : []),
].map(item => ({
  ...item,
  href: getRelativeLocaleUrl(locale, item.path),
  active: item.path === "" ? currentPath === "/" : isActive(`/${item.path}`),
}));
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-70 px-3 py-2 transition-all focus:top-2"
>
  {t.a11y.skipToContent}
</a>

<header class="gnav">
  <div class="gnav-inner app-layout-wide">
    <a href={getRelativeLocaleUrl(locale, "")} class="gnav-logo">
      {site.title}
    </a>
    <nav aria-label={t.a11y.mainNav}>
      <ul class="gnav-links">
        {
          navItems
            .filter(({ path }) => path !== "")
            .map(({ href, label, active }) => (
              <li>
                <a href={href} aria-current={active ? "page" : undefined}>
                  {label}
                </a>
              </li>
            ))
        }
      </ul>
    </nav>
    {
      features.search !== false && (
        <a
          href={getRelativeLocaleUrl(locale, "search")}
          class="gnav-icon"
          title={t.nav.search}
          aria-label={t.nav.search}
        >
          <IconSearch />
        </a>
      )
    }
    {
      features.lightAndDarkMode && (
        <button
          id="theme-btn"
          class="gnav-icon relative"
          title={t.a11y.toggleTheme}
          aria-label="auto"
          aria-live="polite"
        >
          <IconMoon class="absolute scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
          <IconSunHigh class="absolute scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
        </button>
      )
    }
    <button
      id="menu-btn"
      class="gnav-icon gnav-burger"
      aria-label={t.a11y.openMenu}
      aria-expanded="false"
      aria-controls="menu-sheet"
      data-label-open={t.a11y.openMenu}
      data-label-close={t.a11y.closeMenu}
    >
      <IconX id="close-icon" class="hidden" />
      <IconMenuDeep id="menu-icon" />
    </button>
  </div>
</header>

<nav
  id="menu-sheet"
  class="menu-sheet"
  aria-label={t.a11y.menu}
  data-open="false"
>
  <ul>
    {
      navItems.map(({ href, label, active }, i) => (
        <li>
          <a
            href={href}
            style={`--i:${i}`}
            aria-current={active ? "page" : undefined}
          >
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  function setMenu(open: boolean) {
    const btn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const sheet = document.querySelector<HTMLElement>("#menu-sheet");
    if (!btn || !sheet) return;
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute(
      "aria-label",
      (open ? btn.dataset.labelClose : btn.dataset.labelOpen) ?? "Menu"
    );
    sheet.dataset.open = String(open);
    document.querySelector("#menu-icon")?.classList.toggle("hidden", open);
    document.querySelector("#close-icon")?.classList.toggle("hidden", !open);
    document.documentElement.style.overflow = open ? "hidden" : "";
    document
      .querySelectorAll("main, footer")
      .forEach(el => ((el as HTMLElement).inert = open));
    if (open) {
      sheet.getBoundingClientRect();
      sheet.querySelector<HTMLAnchorElement>("a")?.focus();
    }
  }

  function toggleNav() {
    const btn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const sheet = document.querySelector<HTMLElement>("#menu-sheet");
    if (!btn || !sheet) return;
    btn.addEventListener("click", () =>
      setMenu(btn.getAttribute("aria-expanded") !== "true")
    );
    sheet.addEventListener("click", e => {
      if ((e.target as HTMLElement).closest("a")) setMenu(false);
    });
  }

  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          {
            once: true,
          }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  document.addEventListener("keydown", e => {
    const btn = document.querySelector<HTMLButtonElement>("#menu-btn");
    if (e.key === "Escape" && btn?.getAttribute("aria-expanded") === "true") {
      setMenu(false);
      btn.focus();
    }
  });
  matchMedia("(min-width: 1024px)").addEventListener("change", e => {
    if (e.matches) setMenu(false);
  });

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);
</script>
