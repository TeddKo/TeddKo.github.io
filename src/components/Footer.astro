---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();
const links = [
  { href: getRelativeLocaleUrl(locale, "posts"), label: t.nav.posts },
  { href: getRelativeLocaleUrl(locale, "projects"), label: t.nav.projects },
  { href: getRelativeLocaleUrl(locale, "about"), label: t.nav.about },
  {
    href: `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`,
    label: "RSS",
  },
];
---

<footer
  class:list={["site-footer", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="app-layout-wide py-6">
    <div
      class="border-border flex flex-col items-start justify-between gap-3 border-b pb-4 sm:flex-row sm:items-center"
    >
      <ul class="flex flex-wrap gap-x-5 gap-y-1">
        {
          links.map(({ href, label }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))
        }
      </ul>
      <Socials />
    </div>
    <p class="pt-4">
      {t.footer.copyright} &#169; {currentYear}{" "}
      {config.site.title}. {t.footer.allRightsReserved}
    </p>
  </div>
</footer>
