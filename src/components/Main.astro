---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  eyebrow?: string;
  /** Slot content manages its own sections and widths. */
  bare?: boolean;
  /** 1200px canvas for tile grids instead of 980px. */
  wide?: boolean;
  class?: string;
};

const {
  pageTitle,
  pageDesc,
  eyebrow,
  bare = false,
  wide = false,
  class: className,
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  id="main-content"
  class:list={["flex-1", className]}
>
  <header
    class:list={[
      "pt-14 pb-10 sm:pt-24 sm:pb-16",
      wide ? "app-layout-wide" : "app-layout",
    ]}
    data-load
  >
    {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
    <h1 class="display">{pageTitle}</h1>
    {pageDesc && <p class="lead mt-5 max-w-3xl">{pageDesc}</p>}
  </header>
  {
    bare ? (
      <slot />
    ) : (
      <div
        class:list={["pb-24 sm:pb-32", wide ? "app-layout-wide" : "app-layout"]}
      >
        <slot />
      </div>
    )
  }
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
