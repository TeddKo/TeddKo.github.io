---
import { getCollection } from "astro:content";
import CategoryList from "@/components/CategoryList.astro";
import MobileFilter from "@/components/MobileFilter.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { MOBILE_SUBS } from "@/utils/categories";
import { useTranslations } from "@/i18n";
import config from "@/config";

const t = useTranslations(Astro.currentLocale ?? config.site.lang);
const slugs: string[] = [...MOBILE_SUBS];
const posts = getSortedPosts(
  await getCollection("posts", ({ data }) => slugs.includes(data.category))
);
---

<CategoryList
  title={t.nav.mobile}
  eyebrow={t.categories.mobileEyebrow}
  description={t.categories.mobileDesc}
  posts={posts}
>
  <MobileFilter />
</CategoryList>
