---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import CategoryList from "@/components/CategoryList.astro";
import MobileFilter from "@/components/MobileFilter.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { LANGUAGE_SUBS } from "@/utils/categories";
import { useTranslations, tplStr } from "@/i18n";
import config from "@/config";

export const getStaticPaths = (async () => {
  const all = await getCollection("posts");
  return LANGUAGE_SUBS.map(slug => ({
    params: { sub: slug },
    props: {
      slug,
      posts: getSortedPosts(all.filter(({ data }) => data.category === slug)),
    },
  }));
}) satisfies GetStaticPaths;

const { slug, posts } = Astro.props;
const t = useTranslations(Astro.currentLocale ?? config.site.lang);
const label = t.categories.labels[slug];
---

<CategoryList
  title={label}
  eyebrow={t.categories.languageEyebrow}
  description={tplStr(t.categories.subDesc, { label })}
  posts={posts}
>
  <MobileFilter
    current={slug}
    subs={LANGUAGE_SUBS}
    base="language"
    label={t.categories.languageFilterLabel}
  />
</CategoryList>
