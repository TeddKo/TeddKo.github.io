---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { projects } from "@/data/projects";
import { useTranslations } from "@/i18n";
import config from "@/config";

const t = useTranslations(Astro.currentLocale ?? config.site.lang);
const description = t.projects.description;
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const ordered = [
  ...projects.filter(p => p.detailUrl),
  ...projects.filter(p => !p.detailUrl),
];
---

<Layout title={`Projects | ${config.site.title}`} {description}>
  <Header />
  <Main
    pageTitle={t.nav.projects}
    pageDesc={description}
    eyebrow={t.projects.eyebrow}
    wide
  >
    <ul class="tile-grid tile-grid-2">
      {
        ordered.map(
          ({ title, period, description, tags, url, detailUrl }, i) => {
            const href = detailUrl ? `${base}${detailUrl}` : url;
            const feature = Boolean(detailUrl);
            return (
              <li
                class:list={[
                  "tile flex flex-col",
                  { "tile-ink sm:col-span-2 sm:min-h-[22rem]": feature },
                ]}
                style={`--i:${feature ? 0 : i % 2}`}
                data-reveal
              >
                <p class="eyebrow eyebrow-quiet text-base!">{period}</p>
                <h2
                  class:list={[
                    "tile-title mt-2",
                    { "text-[clamp(1.75rem,4vw,2.75rem)]": feature },
                  ]}
                >
                  {href ? (
                    <a
                      href={href}
                      class="tile-link"
                      target={detailUrl ? undefined : "_blank"}
                      rel={detailUrl ? undefined : "noopener noreferrer"}
                    >
                      {title}
                    </a>
                  ) : (
                    title
                  )}
                </h2>
                <p
                  class:list={[
                    "secondary mt-3",
                    feature ? "max-w-2xl text-lg" : "text-base",
                  ]}
                >
                  {description}
                </p>
                <ul class="mt-auto flex flex-wrap gap-2 pt-6">
                  {tags.map(tag => (
                    <li class="chip">{tag}</li>
                  ))}
                </ul>
                {feature && (
                  <span class="link-more mt-6" aria-hidden="true">
                    {t.projects.detailLink}
                  </span>
                )}
              </li>
            );
          }
        )
      }
    </ul>
  </Main>
  <Footer />
</Layout>
